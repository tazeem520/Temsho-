{
  "expo": {
    "name": "Temsho",
    "slug": "temsho",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.temsho.app",
      "buildNumber": "30"
    },
    "android": {
      "package": "in.temsho.app",
      "versionCode": 30,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A56DB"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro",
      "output": "single"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "primaryColor": "#1A56DB",
    "scheme": "temsho",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A56DB"
    },
    "plugins": [
      "./plugins/withAndroidQueries",
      [
        "expo-image-picker",
        {
          "photosPermission": "Temsho requires photo library access to upload product photos.",
          "cameraPermission": "Temsho requires camera access to capture product photos and scan QR codes."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1A56DB"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "724bf72f-0b64-4f86-bdb8-45d73b2f88f8"
      }
    },
    "owner": "temsho"
  }
}
