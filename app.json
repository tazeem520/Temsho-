{
  "expo": {
    "name": "Temsho",
    "slug": "temsho",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.temsho.app",
      "buildNumber": "9"
    },
    "android": {
      "package": "in.temsho.app",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2B2D6E"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro",
      "output": "single"
    },
    "platforms": ["ios", "android", "web"],
    "primaryColor": "#2B2D6E",
    "scheme": "temsho",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2B2D6E"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Temsho requires photo library access to upload product photos.",
          "cameraPermission": "Temsho requires camera access to capture product photos and scan QR codes."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2B2D6E"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "635c68af-4510-426a-92db-0c482241236e"
      }
    },
    "owner": "t1a2z3e4e5m6"
  }
}
